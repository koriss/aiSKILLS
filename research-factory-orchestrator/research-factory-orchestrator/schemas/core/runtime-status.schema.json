{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rfo.local/schemas/v19/runtime-status.schema.json",
  "title": "RuntimeStatus",
  "type": "object",
  "additionalProperties": true,
  "required": ["run_id", "state"],
  "properties": {
    "schema_version": { "type": "string" },
    "run_id": { "type": "string", "minLength": 1 },
    "job_id": { "type": "string" },
    "command_id": { "type": "string" },
    "version": { "type": "string" },
    "state": {
      "type": "string",
      "enum": [
        "initialized",
        "content_rendered",
        "delivery_queued",
        "outbox_finalized",
        "delivered",
        "stub_delivered",
        "partial_delivery",
        "validation_failed",
        "failed",
        "delivery_pending",
        "validation_passed"
      ]
    },
    "updated_at": { "type": "string" },
    "last_event": { "type": "string" },
    "notes": { "type": "string" }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-factory-orchestrator.local/contracts/rfo-effective-config-v2.schema.json",
  "title": "RFO effective config snapshot (source-packet canonical execute)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "entrypoint",
    "profile",
    "skill_root",
    "workspace_root",
    "workspace_root_source",
    "runs_root",
    "runs_root_source",
    "relay",
    "relay_source",
    "relay_chain",
    "deprecated_inputs_used",
    "forbidden_inputs_present",
    "canonical",
    "run_execution_mode",
    "production_research",
    "fixture_mode",
    "search_mode",
    "blocked_dependency",
    "errors",
    "source_packet_path",
    "source_packet_sha256"
  ],
  "properties": {
    "schema": { "const": "rfo-effective-config-v2" },
    "entrypoint": { "type": "string", "minLength": 1 },
    "profile": { "type": "string", "minLength": 1 },
    "skill_root": { "type": "string", "minLength": 1 },
    "workspace_root": { "type": ["string", "null"] },
    "workspace_root_source": { "type": ["string", "null"] },
    "runs_root": { "type": ["string", "null"] },
    "runs_root_source": { "type": ["string", "null"] },
    "relay": { "type": ["string", "null"] },
    "relay_source": { "type": ["string", "null"] },
    "relay_chain": { "type": "array", "items": { "type": "string" } },
    "deprecated_inputs_used": { "type": "array", "items": { "type": "string" } },
    "forbidden_inputs_present": { "type": "array", "items": { "type": "string" } },
    "canonical": { "type": "boolean" },
    "run_execution_mode": {
      "type": "string",
      "enum": ["canonical_production", "test_fixture", "blocked_external_dependency"]
    },
    "production_research": { "type": "boolean" },
    "fixture_mode": { "type": "boolean" },
    "search_mode": {
      "type": "string",
      "enum": ["relay", "fixture_relay", "agent_supplied_packet"]
    },
    "blocked_dependency": { "type": ["string", "null"] },
    "errors": { "type": "array", "items": { "type": "string" } },
    "source_packet_path": { "type": "string" },
    "source_packet_sha256": { "type": "string", "minLength": 32 },
    "validation_profile": { "type": ["string", "null"] },
    "execution_authenticity": { "type": ["string", "null"] },
    "evidence_scope": { "type": ["string", "null"] },
    "collection_integrity": { "type": ["string", "null"] }
  }
}

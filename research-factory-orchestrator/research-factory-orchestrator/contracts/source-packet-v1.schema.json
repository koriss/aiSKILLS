{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-factory-orchestrator.local/contracts/source-packet-v1.schema.json",
  "title": "RFO source-packet (agent-assembled evidence bundle)",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "topic", "created_at", "profile", "sources"],
  "properties": {
    "schema_version": { "type": "string", "const": "source-packet-v1" },
    "topic": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "minLength": 10 },
    "profile": { "type": "string", "minLength": 1 },
    "validation_profile": { "type": "string" },
    "execution_authenticity": { "type": "string" },
    "evidence_scope": { "type": "string" },
    "collection_integrity": { "type": "string" },
    "collection_methods": { "type": "array", "items": { "type": "string" } },
    "blocked": { "type": "boolean" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "object", "additionalProperties": true }
    }
  }
}

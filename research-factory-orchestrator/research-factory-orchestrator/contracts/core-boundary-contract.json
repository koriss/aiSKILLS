{
  "version": "19.3.0",
  "description": "RFO runtime boundary for v19-only stack.",
  "entrypoints": {
    "cli_main": "runtime/cli.py:main",
    "script_facade": "scripts/rfo_runtime_core.py -> runtime.cli.main"
  },
  "implementation_modules": [
    "runtime/adapter_impl.py",
    "runtime/artifact_execute_impl.py",
    "runtime/worker_impl.py",
    "runtime/outbox_impl.py",
    "runtime/validate_impl.py",
    "runtime/smoke_impl.py",
    "runtime/failure_impl.py"
  ],
  "supporting_modules": [
    "runtime/util.py",
    "runtime/render.py",
    "runtime/schema_defaults.py",
    "runtime/publish_policy.py",
    "runtime/capability.py",
    "runtime/trace.py",
    "runtime/collector.py",
    "runtime/coverage.py",
    "runtime/citation_grounding.py"
  ],
  "rule": "New orchestration code targets runtime/*_impl.py and runtime/cli.py.",
  "validation_artifacts": [
    "validation-transcript.json",
    "delivery-manifest.json",
    "final-answer-gate.json",
    "run-events.jsonl"
  ]
}
